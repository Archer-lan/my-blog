---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getTagGroups } from '~/lib/posts';
import { t, localizedHref, type Locale } from '~/i18n';

const locale: Locale = 'zh';
const dict = t(locale);
const groups = await getTagGroups(locale);

const sorted = [...groups].sort((a, b) => {
  if (b.count !== a.count) return b.count - a.count;
  return a.name.localeCompare(b.name, locale);
});

const POPULAR_THRESHOLD = 3;
const popular = sorted.filter((g) => g.count >= POPULAR_THRESHOLD);
const others = sorted.filter((g) => g.count < POPULAR_THRESHOLD);
---

<BaseLayout title={dict.tags.title} description={dict.tags.title} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24">
    <header class="mb-12 border-b border-[color:var(--color-border)] pb-8">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)]">
        {dict.tags.eyebrow}
      </p>
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">{dict.tags.title}</h1>
      <p class="mt-3 text-[color:var(--color-fg-muted)]">
        {dict.tags.count(groups.length)}
      </p>
    </header>

    {groups.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-[color:var(--color-border)] p-12 text-center text-[color:var(--color-fg-muted)]">
        {dict.tags.emptyAll}
      </p>
    ) : (
      <div class="flex flex-col gap-12">
        {popular.length > 0 && (
          <div>
            <h2 class="mb-5 text-xs uppercase tracking-[0.3em] text-[color:var(--color-fg-subtle)]">
              {dict.tags.popularHeading}
            </h2>
            <ul class="flex flex-wrap gap-2">
              {popular.map((g) => (
                <li>
                  <a
                    href={localizedHref(locale, `/tags/${encodeURIComponent(g.name)}`)}
                    class="group inline-flex items-center gap-2 rounded-full border border-[color:var(--color-accent)]/30 bg-[color:var(--color-accent)]/[0.06] px-3.5 py-1.5 text-sm transition-colors hover:border-[color:var(--color-accent)]/60 hover:bg-[color:var(--color-accent)]/[0.12]"
                  >
                    <span class="text-[color:var(--color-fg)]">#{g.name}</span>
                    <span class="rounded-full bg-[color:var(--color-accent)]/15 px-1.5 py-0.5 text-[10px] font-medium text-[color:var(--color-accent)] tabular-nums">
                      {g.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {others.length > 0 && (
          <div>
            <h2 class="mb-5 text-xs uppercase tracking-[0.3em] text-[color:var(--color-fg-subtle)]">
              {dict.tags.othersHeading}
            </h2>
            <ul class="flex flex-wrap gap-2">
              {others.map((g) => (
                <li>
                  <a
                    href={localizedHref(locale, `/tags/${encodeURIComponent(g.name)}`)}
                    class="group inline-flex items-center gap-1.5 rounded-full border border-[color:var(--color-border)] px-3 py-1 text-sm text-[color:var(--color-fg-muted)] transition-colors hover:border-[color:var(--color-border-strong)] hover:text-[color:var(--color-fg)]"
                  >
                    <span>#{g.name}</span>
                    <span class="text-[10px] text-[color:var(--color-fg-subtle)] tabular-nums">
                      {g.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </section>
</BaseLayout>
