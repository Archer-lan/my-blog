---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getTagGroups } from '~/lib/posts';
import { t, localizedHref, type Locale } from '~/i18n';

const locale: Locale = 'en';
const dict = t(locale);
const groups = await getTagGroups(locale);

const maxCount = Math.max(1, ...groups.map((g) => g.count));
const sizeFor = (count: number) => {
  const ratio = count / maxCount;
  if (ratio > 0.66) return 'text-2xl md:text-3xl';
  if (ratio > 0.33) return 'text-xl';
  return 'text-base';
};
---

<BaseLayout title={dict.tags.title} description={dict.tags.title} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24">
    <header class="mb-12 border-b border-[color:var(--color-border)] pb-8">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)]">
        {dict.tags.eyebrow}
      </p>
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">{dict.tags.title}</h1>
      <p class="mt-3 text-[color:var(--color-fg-muted)]">
        {dict.tags.count(groups.length)}
      </p>
    </header>

    {groups.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-[color:var(--color-border)] p-12 text-center text-[color:var(--color-fg-muted)]">
        {dict.tags.emptyAll}
      </p>
    ) : (
      <ul class="flex flex-wrap items-baseline gap-x-4 gap-y-3">
        {groups.map((g) => (
          <li>
            <a
              href={localizedHref(locale, `/tags/${encodeURIComponent(g.name)}`)}
              class:list={[
                'group inline-flex items-baseline gap-2 transition-colors',
                'text-[color:var(--color-fg-muted)] hover:text-[color:var(--color-accent)]',
                sizeFor(g.count),
              ]}
            >
              <span>#{g.name}</span>
              <span class="text-xs text-[color:var(--color-fg-subtle)] group-hover:text-[color:var(--color-accent)]/60">
                {g.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
