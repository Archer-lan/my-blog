---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { getTagGroups } from '~/lib/posts';
import { t, localizedHref, type Locale } from '~/i18n';

export async function getStaticPaths() {
  const groups = await getTagGroups('en');
  return groups.map((g) => ({
    params: { tag: g.name },
    props: { tag: g.name, posts: g.posts, count: g.count },
  }));
}

const { tag, posts, count } = Astro.props;
const locale: Locale = 'en';
const dict = t(locale);
---

<BaseLayout title={`#${tag}`} description={`#${tag}`} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24">
    <header class="mb-12 border-b border-[color:var(--color-border)] pb-8">
      <a href={localizedHref(locale, '/tags')} class="mb-3 inline-block text-xs uppercase tracking-[0.3em] text-[color:var(--color-fg-muted)] transition-colors hover:text-[color:var(--color-accent)]">
        {dict.tags.backToAll}
      </a>
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">
        <span class="text-[color:var(--color-fg-subtle)]">#</span>{tag}
      </h1>
      <p class="mt-3 text-[color:var(--color-fg-muted)]">
        {dict.tags.perTagCount(count)}
      </p>
    </header>

    <PostList posts={posts} emptyText={dict.tags.empty} locale={locale} />
  </section>
</BaseLayout>
