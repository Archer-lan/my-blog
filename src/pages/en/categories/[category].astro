---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { getCategoryGroups } from '~/lib/posts';
import { t, localizedHref, type Locale } from '~/i18n';

export async function getStaticPaths() {
  const groups = await getCategoryGroups('en');
  return groups.map((g) => ({
    params: { category: g.name },
    props: { category: g.name, posts: g.posts, count: g.count },
  }));
}

const { category, posts, count } = Astro.props;
const locale: Locale = 'en';
const dict = t(locale);
---

<BaseLayout title={category} description={category} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24">
    <header class="mb-12 border-b border-[color:var(--color-border)] pb-8">
      <a href={localizedHref(locale, '/categories')} class="mb-3 inline-block text-xs uppercase tracking-[0.3em] text-[color:var(--color-fg-muted)] transition-colors hover:text-[color:var(--color-accent)]">
        {dict.categories.backToAll}
      </a>
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">{category}</h1>
      <p class="mt-3 text-[color:var(--color-fg-muted)]">
        {dict.categories.perCatCount(count)}
      </p>
    </header>

    <PostList posts={posts} emptyText={dict.categories.empty} locale={locale} />
  </section>
</BaseLayout>
