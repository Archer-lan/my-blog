---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import Pagination from '~/components/Pagination.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '~/lib/posts';
import { t, localizedHref, type Locale } from '~/i18n';

const locale: Locale = 'zh';
const dict = t(locale);

const allPosts = await getPublishedPosts(locale);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout title={dict.archive.title} description={dict.archive.title} locale={locale}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-24">
    <header class="mb-12 border-b border-[color:var(--color-border)] pb-8">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)]">
        {dict.archive.eyebrow}
      </p>
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">{dict.archive.title}</h1>
      <p class="mt-3 text-[color:var(--color-fg-muted)]">
        {dict.archive.countLine(allPosts.length, 1, totalPages)}
      </p>
    </header>

    <PostList posts={posts} locale={locale} />
    <Pagination currentPage={1} totalPages={totalPages} baseHref={localizedHref(locale, '/posts')} locale={locale} />
  </section>
</BaseLayout>
