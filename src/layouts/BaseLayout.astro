---
import '~/styles/app.css';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import SearchModal from '~/components/SearchModal.astro';
import { SITE } from '~/config';
import { t, getLocale, localizedHref, type Locale } from '~/i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: 'website' | 'article';
  locale?: Locale;
  altLocaleHref?: string;
  hideLangToggle?: boolean;
  /** Optional JSON-LD object to embed for structured data. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogImage,
  pageType = 'website',
  locale: localeProp,
  altLocaleHref,
  hideLangToggle,
  jsonLd,
} = Astro.props;

const locale = localeProp ?? getLocale(Astro.url);
const dict = t(locale);

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const siteOrigin = Astro.site ?? new URL('https://archer-lan.github.io');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteUrl = (path: string) => new URL(path, siteOrigin).toString();

const resolvedOgImage = absoluteUrl(ogImage ?? `${base}/og-default.png`);
const rssHref = absoluteUrl(localizedHref(locale, '/rss.xml'));
const sitemapHref = absoluteUrl(`${base}/sitemap-index.xml`);
const altLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const altLocaleFallbackHref = absoluteUrl(localizedHref(altLocale, '/'));
const xDefaultHref = absoluteUrl(localizedHref('zh', '/'));
---

<!doctype html>
<html lang={dict.htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href={sitemapHref} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · RSS`} href={rssHref} />
    <link rel="alternate" hreflang={dict.htmlLang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLocale === 'zh' ? 'zh-CN' : 'en'} href={altLocaleHref ? absoluteUrl(altLocaleHref) : altLocaleFallbackHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dict.htmlLang.replace('-', '_')} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored ?? (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="min-h-dvh flex flex-col bg-[color:var(--color-bg)] text-[color:var(--color-fg)]">
    <Navbar locale={locale} altLocaleHref={altLocaleHref} hideLangToggle={hideLangToggle} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchModal locale={locale} />
  </body>
</html>
